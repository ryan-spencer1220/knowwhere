# Copy to .env and fill in. Values prefixed with EXPO_PUBLIC_ are embedded
# in the app bundle, so only put publishable keys here (the anon key is
# safe — it is gated by Row Level Security).

# Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Cloud -> Places API key (used by the Add screen autocomplete)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
