# Copy to .env and fill in. Values prefixed with EXPO_PUBLIC_ are embedded
# in the app bundle, so only put publishable keys here (the anon key is
# safe — it is gated by Row Level Security).

# Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Sentry DSN (optional). Leave blank to disable crash reporting entirely;
# set it to turn on error/crash capture. Sentry project settings -> Client Keys.
EXPO_PUBLIC_SENTRY_DSN=
